{
  "manifest_version": 3,
  "name": "Binance Cookie → curl",
  "version": "1.1",
  "description": "监听币安接口，生成完整 curl 命令",
  "permissions": ["activeTab", "tabs", "debugger"],
  "host_permissions": ["https://*.binance.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "生成币安 curl 命令",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
