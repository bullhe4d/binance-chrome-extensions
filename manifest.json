{
  "manifest_version": 3,
  "name": "Binance Cookie → curl",
  "version": "1.0",
  "description": "捕获币安请求头并生成 curl 命令",
  "permissions": ["cookies", "activeTab", "scripting", "tabs", "webRequest", "storage"],
  "host_permissions": ["https://*.binance.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "生成币安 curl 命令",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
